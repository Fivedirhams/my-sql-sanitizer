# =============================================================================
# MySQL Sanitizer — Environment Variables
# =============================================================================
# Скопируйте в .env и вставьте свой ключ LLM-провайдера:
#   cp .env.example .env && vim .env
#
# По умолчанию используется провайдер ofox (OpenAI-совместимый API).
# Kodik Router оставлен как альтернатива — просто поменяйте endpoint/model.
# =============================================================================

# ── Required: API Key провайдера ────────────────────────────────
LLM_API_KEY=sk-your-api-key-here
# Legacy-алиас (не обязателен; код читает LLM_API_KEY первым):
# KODIK_API_KEY=sk-your-api-key-here

# ── LLM Endpoint + Model ────────────────────────────────────────
# ofox (по умолчанию):
LLM_ENDPOINT=https://api.ofox.ai/v1
LLM_MODEL=bailian/qwen3.8-flash
# Альтернатива — Kodik Router:
# LLM_ENDPOINT=https://api.kodikrouter.ru/v1
# LLM_MODEL=qwen/qwen3.7-flash

# ── Optional: бюджет генерации и батчинг ────────────────────────
# Выходные токены на один запрос к API (для больших чанков значений).
LLM_MAX_COMPLETION_TOKENS=32768
BATCH_SIZE=20
