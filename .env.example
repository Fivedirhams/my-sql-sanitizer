# =============================================================================
# CloakDB — Environment Variables
# =============================================================================
# Copy to .env and fill in your Kodik Router API key:
#   cp .env.example .env && vim .env
#
# Or build Docker image with token baked in:
#   docker buildx build --build-arg KODIK_API_KEY=sk-your-key -t cloakdb:latest .

# ── Required: Kodik Router API Key ────────────────────────────
KODIK_API_KEY=sk-your-api-key-here

# ── Optional LLM Settings ─────────────────────────────────────
LLM_ENDPOINT=https://api.kodikrouter.ru/v1
LLM_MODEL=qwen/qwen3.7-flash
MAX_TOKENS=4096
BATCH_SIZE=20
