# =============================================================================
# CloakDB / MySQL Sanitizer — Environment Variables
# =============================================================================
# Настройка LLM-подключения целиком через .env. Скопируйте и заполните:
#   cp .env.example .env && vim .env
#
# Работает с любым OpenAI-совместимым API: укажите провайдер (или свой
# endpoint), модель и токен. Никаких секретов в образ Docker не попадает —
# ключ читается в рантайме.
# =============================================================================

# ── Required: токен доступа ───────────────────────────────────
LLM_API_KEY=sk-your-api-key-here
# Альтернативное имя (читается так же):
# LLM_API_TOKEN=sk-your-api-key-here

# ── Provider: ofox | kodik | openai | <свой> ──────────────────
# Задаёт пресеты endpoint и модели. Если LLM_ENDPOINT/LLM_MODEL пустые,
# возьмутся значения по умолчанию для этого провайдера (см. cloaker/config.py).
LLM_PROVIDER=ofox

# ── Advanced: переопределить endpoint и модель вручную ────────
# Оставьте пустыми, чтобы использовать пресет провайдера.
#   ofox      → https://api.ofox.ai/v1        bailian/qwen3.8-flash
#   kodik     → https://api.kodikrouter.ru/v1 qwen/qwen3.7-flash
#   openai    → https://api.openai.com/v1     gpt-4o-mini
LLM_ENDPOINT=
LLM_MODEL=

# ── Optional: бюджет генерации, таймауты и профилирование ────────────
# Выходные токены на один запрос к API.
LLM_MAX_COMPLETION_TOKENS=32768

# Таймаут одного запроса к LLM, сек. Считается АДАПТИВНО по размеру чанка
# (число значений + объём промпта), здесь задаются только границы:
#   нижняя — для маленьких чанков, верхняя — потолок для больших.
# ВАЖНО: многие гейтвеи (в т.ч. ofox) сами обрывают коннект примерно на 60s,
# поэтому смысл не в огромном таймауте, а в маленьком чанке (см. ниже).
LLM_TIMEOUT_BASE=45
LLM_TIMEOUT_MAX=180

# Сколько уникальных значений собрать на каждое поле при профилировании (Phase 1).
SAMPLES_PER_FIELD=50

# Куда складывать JSON-профили полей (Phase 1).
PROFILES_DIR=output/profiles

# Примечание: размер LLM-чанка (≤20 значений за запрос) и автосplit пополам
# при пустом ответе зафиксированы в cloaker/llm_client.py и НЕ настраиваются
# через env — они подобраны под ограничение гейтвея по времени ответа.
