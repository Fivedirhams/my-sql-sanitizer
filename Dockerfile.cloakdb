# =============================================================================
# CloakDB — Production Docker Image
# CloakDB — Production Docker Image (OpenAI-compatible LLM, no secrets baked in)
# =============================================================================
# Usage:
#   # Build image (NO secrets baked in — key supplied at runtime via -e / .env):
#     docker build -t cloakdb:latest .
#
#   # Run (pass LLM key via env; mount SQL dump to /input, take result from /output):
#     docker run --rm -e LLM_API_KEY=sk-your-key \
#       -v ./my_dump.sql:/input/dump.sql -v ./results:/output cloakdb:latest
# =============================================================================

FROM python:3.11-slim

# ── UTF-8 locale (fixes UnicodeDecodeError in the interactive wizard) ──
# python:3.11-slim ships with the C/POSIX locale; without this, rich's
# Confirm.ask()/Prompt.ask() can crash reading Cyrillic input from a TTY.
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8

# ── Runtime env defaults (NO secret baked — pass LLM_API_KEY at run time) ──
# The API key is intentionally NOT a build arg; keep secrets out of image layers.
ENV LLM_PROVIDER=ofox \
    LLM_ENDPOINT=https://api.ofox.ai/v1 \
    LLM_MODEL=bailian/qwen3.8-flash

# ── System Dependencies ─────────────────────────────────────────
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

# ── Application Setup ───────────────────────────────────────────
WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt

# Copy application code
COPY cloaker/ ./cloaker/
COPY config.yaml .
COPY examples/ ./examples/
COPY start.sh .

# Create directories
RUN mkdir -p /app/output /input

# Expose nothing (CLI tool, not a service)
EXPOSE 8080/tcp

# Set UTF-8 encoding
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 PYTHONIOENCODING=utf-8

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python3 -c "import cloaker; print('CloakDB ready')" || exit 1

# Default entrypoint — interactive wizard
ENTRYPOINT ["python3", "-m", "cloaker"]
